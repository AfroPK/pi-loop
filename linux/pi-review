#!/usr/bin/env bash
# REVIEWER: a FRESH Swift session (clean context, thinking medium) checks PLAN.md against the task and appends a
# "### REVIEW CORRECTIONS" block + one extra step above ## Verify. It never deletes or rewrites existing steps.
# Usage: pi-review [TASK-file] [pi args]   (add -p to run non-interactively)
set -u
source "$(dirname "$(readlink -f "$0")")/_common.sh"
MODEL_ID=swift27-xs-64k; PI_MODEL=qwen27/swift27-xs-64k
[ -f PLAN.md ] || { echo "No PLAN.md in $PWD - run pi-plan first."; exit 1; }
ensure_server "$MODEL_ID" || exit 1
TASKARG="Review PLAN.md now."
if [ $# -gt 0 ] && [ -f "$1" ]; then
  TASKARG="Review PLAN.md now. The task it was planned from is in $1 - read it first."; shift
fi
prompt_args reviewer.md || exit 1
exec pi --model "$PI_MODEL" --thinking medium --no-skills --tools "read,grep,find,ls,edit,bash" "${P[@]}" --name review "$@" "$TASKARG"
